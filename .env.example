# ============================================================
# ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your values
# ============================================================
# NEVER commit .env to GitHub
# This .env.example file IS safe to commit
# ============================================================

# ── Django Settings ────────────────────────────────────────
# Generate a new key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# ── Database Settings ──────────────────────────────────────
DB_NAME=legaltech_db
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# For Docker, change DB_HOST to 'db':
# DB_HOST=db